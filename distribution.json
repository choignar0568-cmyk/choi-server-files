const { DistributionAPI, HeliosModule } = require('helios-core/common')

const ConfigManager = require('./configmanager')

const BUNDLED_DISTRIBUTION = require('./distribution.json')
const BUNDLED_CLIENT_MODULE_PREFIXES = [
    'curse.maven:cyberhud-1528157:',
    'maven.modrinth:AANobbMI:',
    'maven.modrinth:lfHFW1mp:',
    'maven.modrinth:YL57xq9U:',
    'curse.maven:journeymap-teams-923833:'
]
const BUNDLED_CLIENT_SERVER = BUNDLED_DISTRIBUTION.servers.find(server => server.id === 'choi-server')
const BUNDLED_CLIENT_MODULES = BUNDLED_CLIENT_SERVER?.modules.filter(module =>
    BUNDLED_CLIENT_MODULE_PREFIXES.some(prefix => module.id.startsWith(prefix))) ?? []

// GitHub Pages serves the public distribution index for this launcher.
exports.REMOTE_DISTRO_URL = 'https://choignar0568-cmyk.github.io/choi-server-files/distribution.json'

const api = new DistributionAPI(
    ConfigManager.getLauncherDirectory(),
    null, // Injected forcefully by the preloader.
    null, // Injected forcefully by the preloader.
    exports.REMOTE_DISTRO_URL,
    false
)

// The hosted distribution normally replaces the bundled index. Carry these
// bundled client mods into it for the Minecraft version they target.
function includeBundledClientModules(distribution) {
    if(distribution == null || BUNDLED_CLIENT_SERVER == null || BUNDLED_CLIENT_MODULES.length === 0) {
        return distribution
    }

    const server = distribution.getServerById(BUNDLED_CLIENT_SERVER.id)
    if(server == null || server.rawServer.minecraftVersion !== BUNDLED_CLIENT_SERVER.minecraftVersion) {
        return distribution
    }

    const moduleIds = new Set(server.rawServer.modules.map(module => module.id))
    for(const module of BUNDLED_CLIENT_MODULES) {
        const projectPrefix = BUNDLED_CLIENT_MODULE_PREFIXES.find(prefix => module.id.startsWith(prefix))
        const hasModuleFromProject = [...moduleIds].some(id => id.startsWith(projectPrefix))
        if(hasModuleFromProject) {
            continue
        }

        server.rawServer.modules.push(module)
        server.modules.push(new HeliosModule(module, server.rawServer.id, api.commonDir, api.instanceDir))
        moduleIds.add(module.id)
    }

    return distribution
}

for(const method of ['getDistribution', 'getDistributionLocalLoadOnly', 'refreshDistributionOrFallback']) {
    const loadDistribution = api[method].bind(api)
    api[method] = async (...args) => includeBundledClientModules(await loadDistribution(...args))
}

exports.DistroAPI = api
